# APP
APP_NAME=ai-paper-system
ENV=development

# SECURITY
SECRET_KEY=replace-with-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=180
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_API_TOKEN=replace-with-internal-api-token

# DATABASE
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=require

# Neo4j for user document graph
NEO4J_URI=neo4j+s://<user-graph-instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-user-graph-password
NEO4J_DATABASE=neo4j
NEO4J_USER_DOC_DB=neo4j
AURA_INSTANCEID=<user-graph-instance-id>
AURA_INSTANCENAME=<user-graph-instance-name>

# Neo4j for recommendation graph
NEO4J_REC_URI=neo4j+s://<rec-graph-instance>.databases.neo4j.io
NEO4J_REC_USER=<rec-graph-user>
NEO4J_REC_USERNAME=<rec-graph-user>
NEO4J_REC_PASSWORD=replace-with-rec-graph-password
NEO4J_REC_DATABASE=<rec-graph-database>
NEO4J_REC_AURA_INSTANCEID=<rec-graph-instance-id>
NEO4J_REC_AURA_INSTANCENAME=<rec-graph-instance-name>

# OLLAMA (optional compatibility)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_ENDPOINT=/v1/chat/completions
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=180

# Ingestion lock LLM
INGESTION_LOCKED_OLLAMA_BASE_URL=http://localhost:11434
INGESTION_LOCKED_OLLAMA_CHAT_ENDPOINT=/v1/chat/completions
INGESTION_LOCKED_OLLAMA_MODEL=qwen2.5:7b-instruct

# AI module LLM backend
LLM_BACKEND=vllm
VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL_NAME=qwen2.5:7b-instruct
VLLM_TIMEOUT_SECONDS=180

# Runtime device
STRICT_GPU=false
DEVICE=cpu

# OCR backend
OCR_BACKEND=remote
OCR_BASE_URL=http://localhost:8002
OCR_REMOTE_ENDPOINT=/ocr
OCR_REMOTE_MODEL_NAME=unused
OCR_TIMEOUT_SECONDS=400
OCR_ENGINE=auto
OCR_DPI=72
OCR_REMOTE_CONCURRENCY=2

# Embedding backend
EMBEDDING_BACKEND=remote
EMBEDDING_BASE_URL=http://localhost:8001
EMBEDDING_REMOTE_MODEL_NAME=bge-m3
EMBEDDING_TIMEOUT_SECONDS=120
EMBEDDING_DEVICE=cpu

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# App URLs / CORS
FRONTEND_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# SMTP (OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
OTP_EXPIRE_MINUTES=10

# FASTAPI-MAIL
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
